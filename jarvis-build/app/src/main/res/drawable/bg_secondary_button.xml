<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#263F4D" />
            <stroke android:width="1dp" android:color="#4DEBFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#121D27" />
            <stroke android:width="1dp" android:color="#3D6A75" />
        </shape>
    </item>
</selector>
