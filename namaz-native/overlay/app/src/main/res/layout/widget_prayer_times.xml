<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetTimesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_surface"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/widgetTimesCity" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ankara" android:textColor="#123A30" android:textStyle="bold" android:textSize="12sp" android:maxLines="1" />
        <TextView android:id="@+id/widgetTimesHijri" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 Rebiülahir 1448" android:textColor="#66766F" android:textSize="10sp" android:maxLines="1" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="7dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="İmsak" android:textColor="#78867F" android:textSize="9sp"/><TextView android:id="@+id/widgetTimesImsak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="04:55" android:textColor="#123A30" android:textStyle="bold" android:textSize="12sp"/></LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Güneş" android:textColor="#78867F" android:textSize="9sp"/><TextView android:id="@+id/widgetTimesGunes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="06:20" android:textColor="#123A30" android:textStyle="bold" android:textSize="12sp"/></LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Öğle" android:textColor="#78867F" android:textSize="9sp"/><TextView android:id="@+id/widgetTimesOgle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12:50" android:textColor="#123A30" android:textStyle="bold" android:textSize="12sp"/></LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="İkindi" android:textColor="#78867F" android:textSize="9sp"/><TextView android:id="@+id/widgetTimesIkindi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="16:22" android:textColor="#123A30" android:textStyle="bold" android:textSize="12sp"/></LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Akşam" android:textColor="#78867F" android:textSize="9sp"/><TextView android:id="@+id/widgetTimesAksam" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="19:08" android:textColor="#0C6B50" android:textStyle="bold" android:textSize="12sp"/></LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Yatsı" android:textColor="#78867F" android:textSize="9sp"/><TextView android:id="@+id/widgetTimesYatsi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20:28" android:textColor="#123A30" android:textStyle="bold" android:textSize="12sp"/></LinearLayout>
    </LinearLayout>
</LinearLayout>
