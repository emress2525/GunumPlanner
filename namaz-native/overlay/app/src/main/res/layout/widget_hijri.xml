<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetHijriRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_surface"
    android:padding="14dp">

    <TextView
        android:id="@+id/widgetHijriDay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2"
        android:textColor="#0C6B50"
        android:textStyle="bold"
        android:textSize="36sp" />

    <TextView
        android:id="@+id/widgetHijriRest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rebiülahir 1448"
        android:textColor="#123A30"
        android:textStyle="bold"
        android:textSize="13sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widgetGregorian"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="13 Eylül 2026"
        android:textColor="#66766F"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widgetHijriCity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Ankara"
        android:textColor="#78867F"
        android:textSize="9sp"
        android:maxLines="1" />
</LinearLayout>
