<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetAyahRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_surface"
    android:padding="15dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Günün ayeti"
        android:textColor="#0C6B50"
        android:textStyle="bold"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widgetAyahText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="5dp"
        android:text="Günün ayeti uygulama açılınca güncellenecek."
        android:textColor="#123A30"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:maxLines="4"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widgetAyahSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="#78867F"
        android:textStyle="bold"
        android:textSize="10sp"
        android:maxLines="1" />
</LinearLayout>
