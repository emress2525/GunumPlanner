<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_task_row"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="2dp"
    android:paddingRight="2dp">

    <TextView
        android:id="@+id/widget_task_check"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:gravity="center"
        android:text="○"
        android:textSize="27sp"
        android:textStyle="bold"
        android:textColor="#5B5FEF" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingRight="6dp">

        <TextView
            android:id="@+id/widget_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Görev"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#171923" />

        <TextView
            android:id="@+id/widget_task_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="09:00 • 30 dk"
            android:textSize="10sp"
            android:textColor="#7A7F89" />
    </LinearLayout>

    <TextView
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="›"
        android:textSize="22sp"
        android:textColor="#A3A7B0" />
</LinearLayout>
