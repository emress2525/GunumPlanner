<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Günüm"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#5B5FEF"/>
        <TextView
            android:id="@+id/widget_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="+"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/widget_action_bg"/>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0 açık görev"
        android:textSize="12sp"
        android:textColor="#6B7280"/>

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Sıradaki görev"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#171923"/>

    <TextView
        android:id="@+id/widget_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="30 dk"
        android:textSize="12sp"
        android:textColor="#6B7280"/>

    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>

    <TextView
        android:id="@+id/widget_done"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center"
        android:text="✓ Tamamla"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/widget_done_bg"/>
</LinearLayout>
